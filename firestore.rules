rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string &&
        data.userId == userId &&
        data.email is string &&
        data.email.size() <= 150 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.createdAt is string &&
        data.updatedAt is string;
    }

    function isValidSavedMessage(data, userId) {
      return data.id is string &&
        data.id.size() <= 128 &&
        data.userId is string &&
        data.userId == userId &&
        data.recipientName is string &&
        data.recipientName.size() <= 120 &&
        (!('recipientEmail' in data) || (data.recipientEmail is string && data.recipientEmail.size() <= 150)) &&
        data.originalText is string &&
        data.originalText.size() <= 1000 &&
        data.aslGloss is string &&
        data.aslGloss.size() <= 1000 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        data.createdAt is string &&
        data.updatedAt is string;
    }

    function isValidCustomSign(data, userId) {
      return data.id is string &&
        data.id.size() <= 128 &&
        data.userId is string &&
        data.userId == userId &&
        data.gloss is string &&
        data.gloss.size() <= 80 &&
        (!('sampleCount' in data) || data.sampleCount is number) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        data.createdAt is string &&
        data.updatedAt is string;
    }

    // Users collection and subcollections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']);
      allow update: if isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if isOwner(userId);

      // Subcollection: savedMessages (Messages & ASL translations linked to contacts)
      match /savedMessages/{messageId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidId(messageId) &&
          isValidSavedMessage(incoming(), userId) &&
          incoming().keys().hasAll(['id', 'userId', 'recipientName', 'originalText', 'aslGloss', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['id', 'userId', 'recipientName', 'recipientEmail', 'originalText', 'aslGloss', 'category', 'createdAt', 'updatedAt']);
        allow update: if isOwner(userId) &&
          isValidSavedMessage(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['recipientName', 'recipientEmail', 'originalText', 'aslGloss', 'category', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      // Subcollection: customSigns (Trained ASL models and custom signs)
      match /customSigns/{signId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          isValidId(signId) &&
          isValidCustomSign(incoming(), userId) &&
          incoming().keys().hasAll(['id', 'userId', 'gloss', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['id', 'userId', 'gloss', 'sampleCount', 'notes', 'createdAt', 'updatedAt']);
        allow update: if isOwner(userId) &&
          isValidCustomSign(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['gloss', 'sampleCount', 'notes', 'updatedAt']);
        allow delete: if isOwner(userId);
      }
    }
  }
}
